COMPOSE_PROJECT_NAME=ows-hetzner-dev

# Image/build tags
REGISTRY=ows
PLATFORM=linux
TAG=latest
ASPNETCORE_ENVIRONMENT=Production

# Database
DATABASE_PASSWORD=change-this-postgres-password
DATABASE_CONNECTION_STRING=Host=database;Port=5432;Database=openworldserver;Username=postgres;Password=change-this-postgres-password;
POSTGRES_HOST_PORT=15432
DATABASE_MEM_LIMIT=768m

# RabbitMQ
RABBITMQ_DEFAULT_USER=dev
RABBITMQ_DEFAULT_PASS=test
RABBITMQ_HOST_PORT=5672
RABBITMQ_MANAGEMENT_HOST_PORT=15672
RABBITMQ_MEM_LIMIT=384m

# Host bind address for the client-facing APIs (Public API, Global Data, Party).
# Default (unset) is 127.0.0.1 = loopback only, reached via the Caddy TLS proxy.
# For IP-based access without TLS (dev), set 0.0.0.0. See docs/hosting/hetzner-dev.md.
# TODO: move to HTTPS via domains — set OWS_API_BIND=127.0.0.1, configure the domains
#       below + DNS, and deploy with `--profile tls`.
OWS_API_BIND=0.0.0.0

# TLS proxy domains (A records must point at this host; Caddy gets Let's Encrypt certs).
# Only used when deploying with `--profile tls`.
OWS_PUBLIC_API_DOMAIN=api.example.com
OWS_GLOBAL_DATA_DOMAIN=globaldata.example.com

# Server-to-server key for the PlayerShops endpoints. Required outside Development
# (the API fails closed when unset). Set the same value on the UE server machine.
OWS_SAMSARA_SERVICE_KEY=

# Per-service Postgres connection-pool cap. 6 services x this value must stay under
# Postgres max_connections (40). Raise once Postgres has more headroom / PgBouncer.
OWS_DB_MAX_POOL_SIZE=5
OWS_DB_MIN_POOL_SIZE=1

# Session cache (Valkey). Password is required (the container starts with --requirepass).
# Set OWS_SESSION_CACHE_ENABLED=false to bypass the cache and read sessions from Postgres.
UserSessionCacheValkeyPassword=change-me-valkey
OWS_SESSION_CACHE_ENABLED=true

# gRPC (Chat/Party) guard rails. Connection cap + per-connection message rate limit are
# always enforced. OWS_GRPC_REQUIRE_SESSION_AUTH stays false until the UE client sends
# customerguid/usersessionguid gRPC metadata; enabling it before then rejects all streams.
OWS_GRPC_MAX_CONNECTIONS=5000
OWS_GRPC_MSGS_PER_WINDOW=20
OWS_GRPC_RATE_WINDOW_SECONDS=5
OWS_GRPC_REQUIRE_SESSION_AUTH=false

# Host ports. Only Chat gRPC is public; the rest bind to 127.0.0.1 behind the proxy.
OWS_PUBLIC_API_PORT=44302
OWS_GLOBAL_DATA_PORT=44325
OWS_CHAT_GRPC_PORT=50051
OWS_PARTY_HTTP_PORT=44306
OWS_PARTY_GRPC_PORT=44364

# Internal API host ports. These bind to 127.0.0.1 on the server for SSH tunnels.
OWS_INSTANCE_MANAGEMENT_HOST_PORT=44328
OWS_CHARACTER_PERSISTENCE_HOST_PORT=44323

# Service memory limits for a 4 GB Hetzner dev host.
OWS_PUBLIC_API_MEM_LIMIT=384m
OWS_INSTANCE_MANAGEMENT_MEM_LIMIT=384m
OWS_CHARACTER_PERSISTENCE_MEM_LIMIT=384m
OWS_GLOBAL_DATA_MEM_LIMIT=256m
OWS_CHAT_MEM_LIMIT=256m
OWS_PARTY_MEM_LIMIT=384m
