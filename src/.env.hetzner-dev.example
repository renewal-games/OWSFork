COMPOSE_PROJECT_NAME=ows-hetzner-dev

# Image/build tags
REGISTRY=ows
PLATFORM=linux
TAG=latest
ASPNETCORE_ENVIRONMENT=Production

# Database
DATABASE_PASSWORD=change-this-postgres-password
DATABASE_CONNECTION_STRING=Host=database;Port=5432;Database=openworldserver;Username=postgres;Password=change-this-postgres-password;
POSTGRES_HOST_PORT=15432
DATABASE_MEM_LIMIT=768m

# RabbitMQ
RABBITMQ_DEFAULT_USER=dev
RABBITMQ_DEFAULT_PASS=test
RABBITMQ_HOST_PORT=5672
RABBITMQ_MANAGEMENT_HOST_PORT=15672
RABBITMQ_MEM_LIMIT=384m

# Public host ports
OWS_PUBLIC_API_PORT=44302
OWS_GLOBAL_DATA_PORT=44325
OWS_CHAT_GRPC_PORT=50051
OWS_PARTY_HTTP_PORT=44306
OWS_PARTY_GRPC_PORT=44364

# Internal API host ports. These bind to 127.0.0.1 on the server for SSH tunnels.
OWS_INSTANCE_MANAGEMENT_HOST_PORT=44328
OWS_CHARACTER_PERSISTENCE_HOST_PORT=44323

# Service memory limits for a 4 GB Hetzner dev host.
OWS_PUBLIC_API_MEM_LIMIT=384m
OWS_INSTANCE_MANAGEMENT_MEM_LIMIT=384m
OWS_CHARACTER_PERSISTENCE_MEM_LIMIT=384m
OWS_GLOBAL_DATA_MEM_LIMIT=256m
OWS_CHAT_MEM_LIMIT=256m
OWS_PARTY_MEM_LIMIT=384m
